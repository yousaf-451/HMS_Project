digraph ER { rankdir=LR; splines=true; nodesep=0.35; ranksep=1.1; fontname="Helvetica";
node [shape=plain fontname="Helvetica" fontsize=10]; edge [fontname="Helvetica" fontsize=8 color="#475569"];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>users</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">BOOLEAN</FONT></TD></TR></TABLE>>];
